{
  "name": "fides",
  "version": "0.1.0",
  "private": true,
  "description": "Fides — simulated-core EU neobank (modular monolith monorepo)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml}\"",
    "stack:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "stack:down": "docker compose -f infra/docker/docker-compose.yml down",
    "stack:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@fides/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer@<2.1.0": ">=2.1.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "brace-expansion": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "lodash@<4.18.0": ">=4.18.0",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
    }
  }
}
