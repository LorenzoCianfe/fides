{
  "name": "@fides/e2e",
  "version": "0.1.0",
  "private": true,
  "//": "No \"type\": \"module\". Playwright would then load these files through its ESM pipeline, and testcontainers reaches CommonJS-only @grpc/grpc-js, which fails Node's ESM-to-CJS bridge before any test runs.",
  "scripts": {
    "build:stack": "node scripts/build-stack.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@fides/api": "workspace:*",
    "@fides/config": "workspace:*",
    "@fides/web": "workspace:*",
    "@playwright/test": "^1.50.1",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "typescript": "^5.7.2"
  }
}
