# ------------------------------------------------------------------
# Fides — local environment template. Copy to `.env` and adjust.
# Never commit real secrets. `.env` is gitignored; this file is not.
# ------------------------------------------------------------------

# Application
APP_NAME=Fides
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# PostgreSQL (system of record)
# Host port is 5433 to avoid colliding with a native Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=fides
POSTGRES_PASSWORD=fides_local_dev
POSTGRES_DB=fides
DATABASE_URL=postgresql://fides:fides_local_dev@localhost:5433/fides

# Redis (cache, sessions, rate limiting, idempotency keys)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible; MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=fides_minio
S3_SECRET_KEY=fides_minio_local_dev
S3_BUCKET=fides-documents
S3_FORCE_PATH_STYLE=true

# Web client (Slice 8 Wave B). Read at build time, so it is baked into the
# bundle and into the app's CSP `connect-src` — a deployment pointing at a
# different API must rebuild, not just restart.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mobile client (Slice 8 Wave C). Also build-time: EXPO_PUBLIC_* values are
# inlined into the bundle, so nothing secret may ever go here.
EXPO_PUBLIC_API_URL=http://localhost:3000
# The domain native passkeys are bound to. Must equal WEBAUTHN_RP_ID below, and
# it is compiled into the iOS entitlement, so changing it means rebuilding.
# Leave unset for a plain local run: everything except the three passkey
# ceremonies works without it. See docs/mobile-passkeys.md.
# EXPO_PUBLIC_RP_ID=fides-dev.example.com
# App identifiers. These must match IOS_APP_ID and ANDROID_PACKAGE_NAME below,
# which is what the association documents vouch for.
# IOS_BUNDLE_ID=com.fides.app
# ANDROID_PACKAGE=com.fides.app

# Authentication — WebAuthn relying party and sessions (ADR-0020)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3001
# Session lifetimes default to 15 m / 30 d idle / 90 d absolute; override in ms if needed.
# SESSION_ACCESS_TTL_MS=900000
# SESSION_REFRESH_IDLE_TTL_MS=2592000000
# SESSION_ABSOLUTE_TTL_MS=7776000000
# CORS allowlist defaults to WEBAUTHN_ORIGINS; override for extra client origins.
# CORS_ORIGINS=http://localhost:3001

# Cookie token transport for the web client (ADR-0027).
# Opt-in per request: a client sends `X-Fides-Token-Transport: cookie` on the
# routes that mint a session, and gets httpOnly cookies instead of body tokens.
# Mobile sends nothing and keeps the bearer contract unchanged.
# COOKIE_SECURE defaults to true. Browsers treat http://localhost as a secure
# context, so leave it on unless you are serving over plain HTTP on a real host.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict requires the web client and the API to be same-site
# (different ports or subdomains are fine, different registrable domains are
# not). A cross-site deployment needs `none`, which browsers only accept
# together with COOKIE_SECURE=true.
# COOKIE_SAMESITE=strict

# Native passkey app association (ADR-0027).
# When set, the API serves /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json, so whichever HTTPS origin fronts the API — a
# production domain or a local tunnel — publishes valid association files.
# Required for passkeys on a physical device; unset means those routes 404.
# Set WEBAUTHN_RP_ID and WEBAUTHN_ORIGINS to that same public host when tunnelling.
# IOS_APP_ID=ABCDE12345.com.example.fides
# ANDROID_PACKAGE_NAME=com.example.fides
# ANDROID_CERT_FINGERPRINTS=AA:BB:CC:...,11:22:33:...

# Background operations and abuse protection (ADR-0021)
SCHEDULERS_ENABLED=true
THROTTLE_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_MS=2000
CLEANUP_INTERVAL_MS=3600000

# Back office — admin RBAC, MFA, and four-eyes (ADR-0025)
# The first super_admin is seeded at startup and ONLY when no admin exists at all,
# so these cannot be used to add or reset an admin once the back office is live.
# The seeded admin has no second factor: it enrols TOTP at first login, and no
# session is issued until it has. Password must be at least 12 characters.
ADMIN_BOOTSTRAP_EMAIL=ops@fides.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-every-real-environment
# Back-office session: 30-minute sliding idle window, 8-hour absolute cap.
# ADMIN_SESSION_IDLE_TTL_MS=1800000
# ADMIN_SESSION_ABSOLUTE_TTL_MS=28800000
# Blast-radius limit on one admin funding credit (default 1,000,000 = EUR 10,000).
# Not a feature switch: funding is authorized by role, four-eyes, and audit.
ADMIN_FUNDING_MAX_MINOR=1000000
