{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "APP_NAME"],
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_RP_ID",
        "IOS_BUNDLE_ID",
        "ANDROID_PACKAGE"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".expo-export/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "e2e": {
      "cache": false,
      "outputs": []
    }
  }
}
